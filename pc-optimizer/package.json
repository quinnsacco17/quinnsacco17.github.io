{
  "name": "setup-optimizer",
  "productName": "Setup Optimizer",
  "version": "0.1.0",
  "description": "Enter your exact PC setup and get the best per-game settings for a target performance.",
  "main": "electron/main.js",
  "type": "module",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.js",
    "dist:win": "electron-builder --win nsis portable",
    "dist:mac": "electron-builder --mac dmg",
    "web": "npx http-server src -p 8080"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "dependencies": {
    "systeminformation": "^5.23.0"
  },
  "build": {
    "appId": "io.github.quinnsacco17.setupoptimizer",
    "productName": "Setup Optimizer",
    "files": ["electron/**", "src/**", "package.json"],
    "win": { "target": ["nsis", "portable"], "icon": "assets/icon.ico" },
    "mac": { "target": ["dmg"], "category": "public.app-category.utilities" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  }
}
